{
  "name": "kiwami-kanri",
  "version": "1.0.0",
  "description": "極管理 — プロスピA Aランク収集管理アプリ",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./input.css -o ./public/app.css --minify",
    "build:js": "esbuild app.jsx --bundle --minify --format=iife --target=es2018 --outfile=public/app.js",
    "build:static": "node copy-static.mjs",
    "build": "npm run build:css && npm run build:js && npm run build:static",
    "dev:css": "tailwindcss -i ./input.css -o ./public/app.css --watch",
    "dev:js": "esbuild app.jsx --bundle --format=iife --target=es2018 --outfile=public/app.js --watch",
    "serve": "firebase emulators:start --only hosting"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.14"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "protobufjs@7.6.6": true
  }
}
